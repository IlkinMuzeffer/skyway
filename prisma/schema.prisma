generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  orders    Order[]
  hotelBookings HotelBooking[]
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  flightId      Int
  from          String
  to            String
  airline       String
  departure     String
  arrival       String
  date          String
  price         Int
  passengerName String
  phone         String
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())
}

model HotelBooking {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  orderId      String?
  hotelId      Int
  hotelName    String
  city         String
  type         String
  checkIn      String
  checkOut     String
  nights       Int
  pricePerNight Int
  totalPrice   Int
  guestName    String
  status       String   @default("CONFIRMED")
  createdAt    DateTime @default(now())
}